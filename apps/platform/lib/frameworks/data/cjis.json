{
  "key": "cjis",
  "name": "CJIS Security Policy",
  "fullName": "FBI Criminal Justice Information Services (CJIS) Security Policy",
  "publisher": "US Federal Bureau of Investigation (FBI), CJIS Division",
  "version": "v6.1 (25 June 2026); many state CSAs still audit against v5.9.5 during transition",
  "region": "US",
  "appliesTo": "Criminal justice and noncriminal justice agencies, and their contractors and cloud/IT vendors, that access, process, store or transmit Criminal Justice Information (CJI).",
  "note": "Since v6.0 the policy is organised as Policy Area 1 (Information Exchange Agreements), NIST SP 800-53 control families, and Policy Area 20 (Mobile Devices); requirements are mapped at family level, so mappings indicate overlap only and each family contains many detailed, phased controls.",
  "sources": [
    "https://le.fbi.gov/cjis-division/cjis-security-policy-resource-center",
    "https://le.fbi.gov/file-repository/cjis_security_policy_v6-1_20260625-1.pdf",
    "https://www.dps.texas.gov/section/crime-records/cjis-documents",
    "https://www.saltycloud.com/blog/cjis-security-policy/"
  ],
  "requirements": [
    {
      "id": "CJIS-5.1",
      "title": "Information Exchange Agreements",
      "controls": [
        "ops.supplier_mgmt",
        "gov.accountability"
      ]
    },
    {
