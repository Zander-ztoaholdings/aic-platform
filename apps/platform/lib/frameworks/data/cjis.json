      "title": "Configuration Management (CM)",
      "controls": [
        "dev.change_review",
        "ops.asset_inventory",
        "ops.endpoint"
      ]
    },
    {
      "id": "CJIS-CP",
      "title": "Contingency Planning (CP)",
      "controls": [
        "ops.backup"
